#Symmetric Key Encryption Using Modular Traversal of Ananta-Graphs
import tkinter as tk
from tkinter import messagebox

# Function to check if a number is prime
def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

# Define the transformation function f(n)
def f(n, mod):
    return (3 * n + 1) % mod

# Function to perform iterative traversal
def traverse(n, steps, mod):
    for _ in range(steps):
        n = f(n, mod)
    return n

# Encrypt message using shared key
def encrypt_message():
    try:
        message = entry_message.get()
        if not message:
            messagebox.showerror("Input Error", "Please enter a message to encrypt!")
            return

        shared_key = int(label_shared_key_value.cget("text"))

        # Encrypt each character using XOR
        encrypted_text = ''.join(chr((ord(char) ^ shared_key) % 256) for char in message)

        label_encrypted_value.config(text=encrypted_text)

    except ValueError:
        messagebox.showerror("Encryption Error", "Invalid key or message input!")

# Decrypt message using shared key
def decrypt_message():
    try:
        encrypted_text = label_encrypted_value.cget("text")
        if encrypted_text == "-":
            messagebox.showerror("Decryption Error", "No encrypted message found!")
            return

        shared_key = int(label_shared_key_value.cget("text"))

        # Correctly reverse the XOR operation
        decrypted_text = ''.join(chr((ord(char) ^ shared_key) % 256) for char in encrypted_text)

        label_decrypted_value.config(text=decrypted_text)

    except Exception as e:
        messagebox.showerror("Decryption Error", f"Error: {str(e)}")

# Function to perform key exchange
def compute_key_exchange():
    try:
        v0 = int(entry_v0.get())
        a = int(entry_a.get())
        b = int(entry_b.get())
        mod = int(entry_mod.get())

        if not is_prime(mod):
            messagebox.showerror("Invalid Modulus", "Please enter a prime number for security.")
            return

        vA = traverse(v0, a, mod)
        vB = traverse(v0, b, mod)

        K_Alice = traverse(vB, a, mod)
        K_Bob = traverse(vA, b, mod)

        if K_Alice != K_Bob:
            messagebox.showerror("Key Mismatch", "Shared keys do not match!")
            return

        shared_key = K_Alice

        label_vA_value.config(text=str(vA))
        label_vB_value.config(text=str(vB))
        label_shared_key_value.config(text=str(shared_key))

    except ValueError:
        messagebox.showerror("Input Error", "Please enter valid integer values!")

