import tkinter as tk
from tkinter import messagebox
import networkx as nx
import matplotlib.pyplot as plt
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg
import hashlib

# -----------------------------
# Modular traversal function
# -----------------------------
def modular_traversal(n, m, steps):
    path = [n]
    for _ in range(steps):
        n = (3 * n + 1) % m
        path.append(n)
    return path

# -----------------------------
# Key Generation (Algorithm 1)
# -----------------------------
def generate_shared_key(v0, m, a, b):
    vA = modular_traversal(v0, m, a)[-1]
    vB = modular_traversal(v0, m, b)[-1]

    KA = modular_traversal(vB, m, a)[-1]
    KB = modular_traversal(vA, m, b)[-1]

    if KA != KB:
        return None, None, None, None

    # KDF: K' = SHA256(K || v0 || m)
    material = f"{KA}|{v0}|{m}".encode()
    K_prime = hashlib.sha256(material).digest()

    return KA, K_prime, vA, vB

# -----------------------------
# Encryption (Algorithm 2)
# -----------------------------
def encrypt_message(message, key_bytes):
    msg_bytes = message.encode('utf-8')
    cipher_bytes = bytes(
        msg_bytes[i] ^ key_bytes[i % len(key_bytes)]
        for i in range(len(msg_bytes))
    )
    return cipher_bytes.hex()

# -----------------------------
# Decryption (Algorithm 3)
# -----------------------------
def decrypt_message(cipher_hex, key_bytes):
    cipher_bytes = bytes.fromhex(cipher_hex)
    msg_bytes = bytes(
        cipher_bytes[i] ^ key_bytes[i % len(key_bytes)]
        for i in range(len(cipher_bytes))
    )
    return msg_bytes.decode('utf-8')

# -----------------------------
# Tkinter protocol execution
# -----------------------------
def execute_protocol():
    try:
        v0 = int(entry_base.get())
        m = int(entry_modulus.get())
        a = int(entry_alice.get())
        b = int(entry_bob.get())
        message = entry_plaintext.get()

        K, K_prime, vA, vB = generate_shared_key(v0, m, a, b)
        if K is None:
            messagebox.showerror("Key Error", "Shared key mismatch!")
            return

        shared_key.set(f"Shared Traversal Key K: {K}")

        ciphertext = encrypt_message(message, K_prime)
        decrypted = decrypt_message(ciphertext, K_prime)

        entry_ciphertext.delete(0, tk.END)
        entry_ciphertext.insert(0, ciphertext)

        entry_decrypted.delete(0, tk.END)
        entry_decrypted.insert(0, decrypted)

        # -----------------------------
        # Visualization (Binary Tree)
        # -----------------------------
        vA_path = modular_traversal(v0, m, a)
        vB_path = modular_traversal(v0, m, b)

        for widget in window.grid_slaves(row=12, column=0):
            widget.destroy()

        G = nx.DiGraph()
        pos = {}
        offset = 1

        for i in range(len(vA_path) - 1):
            G.add_edge(f"A_{vA_path[i]}", f"A_{vA_path[i+1]}", color='blue')
            pos[f"A_{vA_path[i]}"] = (i, offset)
            pos[f"A_{vA_path[i+1]}"] = (i+1, offset)

        for i in range(len(vB_path) - 1):
            G.add_edge(f"B_{vB_path[i]}", f"B_{vB_path[i+1]}", color='red')
            pos[f"B_{vB_path[i]}"] = (i, -offset)
            pos[f"B_{vB_path[i+1]}"] = (i+1, -offset)

        K_node = f"K_{K}"
        G.add_node(K_node)
        pos[K_node] = (max(len(vA_path), len(vB_path)), 0)

        G.add_edge(f"A_{vA_path[-1]}", K_node, color="black")
        G.add_edge(f"B_{vB_path[-1]}", K_node, color="black")

        fig, ax = plt.subplots(figsize=(10, 5))
        edge_colors = [G[u][v]['color'] for u, v in G.edges()]
        nx.draw(G, pos, with_labels=True, arrows=True,
                node_color="lightyellow", edge_color=edge_colors,
                node_size=900, font_size=9, ax=ax)

        canvas = FigureCanvasTkAgg(fig, master=window)
        canvas.get_tk_widget().grid(row=12, column=0, columnspan=4)
        canvas.draw()

    except Exception as e:
        messagebox.showerror("Error", str(e))

# -----------------------------
# Tkinter GUI
# -----------------------------
window = tk.Tk()
window.title("Modular Ananta-Graph Key Agreement (Paper Version)")

tk.Label(window, text="Base Node (v0):").grid(row=0, column=0)
entry_base = tk.Entry(window)
entry_base.grid(row=0, column=1)

tk.Label(window, text="Prime Modulus (m):").grid(row=1, column=0)
entry_modulus = tk.Entry(window)
entry_modulus.grid(row=1, column=1)

tk.Label(window, text="Alice's Private Key (a):").grid(row=2, column=0)
entry_alice = tk.Entry(window)
entry_alice.grid(row=2, column=1)

tk.Label(window, text="Bob's Private Key (b):").grid(row=3, column=0)
entry_bob = tk.Entry(window)
entry_bob.grid(row=3, column=1)

tk.Label(window, text="Plaintext Message:").grid(row=4, column=0)
entry_plaintext = tk.Entry(window, width=40)
entry_plaintext.grid(row=4, column=1, columnspan=2)

tk.Button(window, text="Run Key Agreement & Encryption",
          command=execute_protocol).grid(row=5, column=0, columnspan=3, pady=10)

shared_key = tk.StringVar()
tk.Label(window, textvariable=shared_key,
         fg="green", font=("Arial", 12, "bold")).grid(row=6, column=0, columnspan=3)

tk.Label(window, text="Ciphertext (hex):").grid(row=7, column=0)
entry_ciphertext = tk.Entry(window, width=40)
entry_ciphertext.grid(row=7, column=1, columnspan=2)

tk.Label(window, text="Decrypted Message:").grid(row=8, column=0)
entry_decrypted = tk.Entry(window, width=40)
entry_decrypted.grid(row=8, column=1, columnspan=2)

window.mainloop()
